{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Sendblue Omni API",
  "description": "Messaging and calling for US numbers: A2P SMS, P2P iMessage, voice, recordings and webhooks.",
  "logo": {
    "light": "/logo/sendblue-mark.svg",
    "dark": "/logo/sendblue-mark.svg",
    "href": "/"
  },
  "favicon": "/logo/sendblue-mark.svg",
  "icons": {
    "library": "lucide"
  },
  "colors": {
    "primary": "#006CCB",
    "light": "#5A98F3",
    "dark": "#005CAE"
  },
  "background": {
    "color": {
      "dark": "#0D1014"
    }
  },
  "fonts": {
    "heading": {
      "family": "Sendblue Aeonik",
      "weight": 500,
      "source": "/fonts/aeonik-medium.woff2",
      "format": "woff2"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "search": {
    "prompt": "Search guides and endpoints..."
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "download-spec",
      "chatgpt",
      "claude"
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required",
      "prefill": true
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/sendblue-api/omni-docs"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.sendblue.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/sendblue-api/omni-docs",
      "website": "https://www.sendblue.com"
    },
    "links": [
      {
        "header": "Products",
        "items": [
          {
            "label": "A2P SMS",
            "href": "/a2p-sms"
          },
          {
            "label": "P2P iMessage",
            "href": "/p2p-imessage"
          },
          {
            "label": "Calling",
            "href": "/calling"
          }
        ]
      },
      {
        "header": "Platform",
        "items": [
          {
            "label": "API overview",
            "href": "/overview"
          },
          {
            "label": "Authentication",
            "href": "/authentication"
          },
          {
            "label": "Webhooks",
            "href": "/webhooks"
          },
          {
            "label": "Errors",
            "href": "/errors"
          }
        ]
      },
      {
        "header": "Sendblue",
        "items": [
          {
            "label": "Website",
            "href": "https://www.sendblue.com"
          },
          {
            "label": "Dashboard",
            "href": "https://dashboard.sendblue.com"
          },
          {
            "label": "GitHub",
            "href": "https://github.com/sendblue-api/omni-docs"
          }
        ]
      }
    ]
  },
  "seo": {
    "metatags": {
      "canonical": "https://omni-docs.sendblue.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "overview",
              "authentication"
            ]
          },
          {
            "group": "A2P SMS",
            "pages": [
              "a2p-sms",
              "quickstart/send-sms",
              "quickstart/receive-sms",
              "quickstart/media"
            ]
          },
          {
            "group": "P2P iMessage",
            "pages": [
              "p2p-imessage",
              "quickstart/imessage-numbers"
            ]
          },
          {
            "group": "Calling",
            "pages": [
              "calling",
              "quickstart/calls",
              "quickstart/record-a-call",
              "quickstart/warm-handoff"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "webhooks",
              "idempotency",
              "errors",
              "pagination"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "api-reference/openapi.yaml"
      }
    ]
  }
}
